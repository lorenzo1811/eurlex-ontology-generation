  "prohibition_rules": [
    {
      "rule_id": "PR-001",
      "condition": {
        "category_pair": [
          "LegalInstrument",
          "EconomicCharge"
        ]
      },
      "action": "forbid_merge",
      "reason": "LegalInstruments and EconomicCharges represent distinct legal and financial concepts."
    },
    {
      "rule_id": "PR-002",
      "condition": {
        "category_pair": [
          "PartyRole",
          "Asset"
        ]
      },
      "action": "forbid_merge",
      "reason": "PartyRoles and Assets represent different entities within a legal system."
    },
    {
      "rule_id": "PR-003",
      "condition": {
        "category_pair": [
          "Restriction",
          "Asset"
        ]
      },
      "action": "forbid_merge",
      "reason": "Restrictions and Assets represent distinct legal and financial concepts."
    }
  ],
  "relationship_inference_rules": [
    {
      "rule_id": "RR-001",
      "condition": {
